:host { display: block; min-height: 100vh; color: #fff; font-family: 'IBM Plex Sans Thai', system-ui, sans-serif; }
.search-page { position: relative; min-height: 100vh; background: #000; }
.overlay-gradient { position: fixed; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,.7) 0%, rgba(0,0,0,.15) 30%, rgba(0,0,0,.7) 80%, #000); z-index: 1; pointer-events: none; }
.content { position: relative; z-index: 3; max-width: 1100px; margin: 0 auto; padding: 0 1.5rem 3rem; }

.nav { display: flex; justify-content: space-between; align-items: center; padding: 1.1rem 0 .5rem; }
.logo { font-size: 1.3rem; font-weight: 800; color: #e50914; text-decoration: none; letter-spacing: .08em; }
.nav-left { display: flex; align-items: center; gap: 1.5rem; }
.nav-links { display: flex; gap: 1rem; }
.nav-link { color: rgba(255,255,255,.6); text-decoration: none; font-size: .9rem; transition: color .2s; &:hover, &.active { color: #fff; } }
.avatar { width: 36px; height: 36px; border-radius: 50%; background: #e53935; display: flex; align-items: center; justify-content: center; font-weight: 700; cursor: pointer; }

.search-header { padding: 2.5rem 0 1.5rem; }
.search-header h1 { font-size: 2rem; font-weight: 700; margin-bottom: .3rem; }
.subtitle { color: rgba(255,255,255,.5); margin-bottom: 1.5rem; }

.search-box-wrap { position: relative; }
.search-icon { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); font-size: 1rem; pointer-events: none; }
.search-box { width: 100%; padding: .85rem 3rem .85rem 2.8rem; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12); border-radius: 12px; color: #fff; font-size: 1rem; font-family: inherit; outline: none; transition: border-color .2s;
  &:focus { border-color: rgba(229,57,53,.5); background: rgba(255,255,255,.09); }
  &::placeholder { color: rgba(255,255,255,.35); }
}
.search-clear { position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); background: none; border: none; color: rgba(255,255,255,.4); cursor: pointer; font-size: 1rem; &:hover { color: #fff; } }

.filters-bar { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.06); border-radius: 12px; padding: 1.2rem 1.5rem; margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
.filter-group { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
.filter-label { font-size: .8rem; color: rgba(255,255,255,.45); white-space: nowrap; width: 90px; flex-shrink: 0; }
.chip-row { display: flex; gap: .4rem; flex-wrap: wrap; }
.chip { padding: .3rem .85rem; border-radius: 999px; font-size: .82rem; background: rgba(255,255,255,.06); color: rgba(255,255,255,.65); border: 1px solid rgba(255,255,255,.1); cursor: pointer; transition: all .2s; font-family: inherit;
  &:hover { background: rgba(255,255,255,.1); color: #fff; }
  &.active { background: rgba(229,57,53,.2); color: #ff6b6b; border-color: rgba(229,57,53,.4); }
}

.results-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; min-height: 32px; }
.results-count { font-size: .9rem; color: rgba(255,255,255,.6); strong { color: #fff; } }
.clear-btn { background: none; border: 1px solid rgba(255,255,255,.15); color: rgba(255,255,255,.6); padding: .3rem .85rem; border-radius: 6px; font-size: .82rem; cursor: pointer; font-family: inherit; &:hover { color: #fff; border-color: rgba(255,255,255,.3); } }

.loading-state { display: flex; justify-content: center; padding: 4rem 0; }
.spinner { width: 36px; height: 36px; border: 3px solid rgba(255,255,255,.1); border-top-color: #e53935; border-radius: 50%; animation: spin .7s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.results-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
.empty-state { grid-column: 1/-1; text-align: center; padding: 4rem 0; color: rgba(255,255,255,.5); }
.empty-icon { font-size: 3rem; margin-bottom: 1rem; }
.empty-state p { margin-bottom: 1.5rem; }

.course-card { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 12px; overflow: hidden; text-decoration: none; color: #fff; display: flex; flex-direction: column; transition: all .2s; cursor: pointer;
  &:hover { background: rgba(255,255,255,.07); border-color: rgba(255,255,255,.15); transform: translateY(-2px); }
}
.card-img-wrap { height: 140px; background: #12121f; overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative; }
.card-img-wrap img { width: 100%; height: 100%; object-fit: cover; opacity: .7; }
.card-img-placeholder { font-size: 3rem; opacity: .3; }
.card-body { padding: 1rem; flex: 1; }
.card-faculty { font-size: .75rem; color: rgba(255,255,255,.45); margin-bottom: .3rem; }
.card-title { font-size: .95rem; font-weight: 600; line-height: 1.4; margin-bottom: .25rem; }
.card-en { font-size: .8rem; color: rgba(255,255,255,.45); margin-bottom: .5rem; }
.card-badges { display: flex; gap: .35rem; flex-wrap: wrap; margin-bottom: .6rem; }
.badge { padding: .2rem .6rem; border-radius: 999px; font-size: .72rem; font-weight: 600; }
.badge.red { background: rgba(229,57,53,.15); color: #ff6b6b; border: 1px solid rgba(229,57,53,.3); }
.badge.gray { background: rgba(255,255,255,.06); color: rgba(255,255,255,.6); }
.card-desc { font-size: .8rem; color: rgba(255,255,255,.45); line-height: 1.5; }
.card-arrow { padding: .6rem 1rem; text-align: right; color: rgba(255,255,255,.25); font-size: 1rem; }

.btn { display: inline-flex; align-items: center; gap: .4rem; padding: .55rem 1.2rem; border-radius: 8px; font-size: .88rem; font-weight: 600; cursor: pointer; text-decoration: none; border: none; font-family: inherit; transition: all .2s; }
.btn.secondary { background: rgba(255,255,255,.08); color: rgba(255,255,255,.8); &:hover { background: rgba(255,255,255,.13); } }

.footer { text-align: center; padding: 2rem 0 1rem; }
.footer-copy { font-size: .8rem; color: rgba(255,255,255,.3); }

@media (max-width: 600px) {
  .nav-links { display: none; }
  .filter-group { flex-direction: column; align-items: flex-start; }
}
